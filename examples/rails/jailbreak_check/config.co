define user express greeting:
  "hi"
  "hello"
  "hey there!"

define user ask about vacation days:
  "how many free days do I get"
  "what is the number of free days"

define bot remove last message
  "(remove last message)"

define bot show last message
    "(show last message)"

define bot inform cannot answer
    "I am not able to answer the question"

define flow check jailbreak
  user ...
  $allowed = execute check_jailbreak

  if not $allowed
    bot remove last message
    bot inform cannot answer
  else
    bot show response for question 
  
